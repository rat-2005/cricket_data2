entary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "10.1", "Id": "66", "UID": null, "OID": null, "Runs": "0", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "65748", "Batsman": "3656", "Commentary": "No run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "65", "UID": null, "OID": null, "Runs": "", "ZAD": null, "Detail": "", "Isball": false, "Bowler": "", "Batsman": "", "Commentary": "After 10 overs, Zimbabwe are staring down the barrel at 38/7 chasing 161 in 22 overs via DLS method. The amazing diving catch taken by Najibullah Zadran at short cover of Musakanda was hands down the standout event in this short passage of play. The pressure of the stiff target has got the better of them and they have thrown their wickets away in hunt of quick runs. It was always going to be a difficult prospect for the hosts as they do not have big hitters in their ranks. The Afghani bowlers have been spot on and Mohammad Nabi is having a gem of a match. After playing a good knock with the bat, he has taken two wickets so far. It seems to be a matter of time before the Afghanis close down the Zimbabwean side. Only a miracle can turn it around for the home side from here.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "9.6", "Id": "64", "UID": null, "OID": null, "Runs": "0", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "7797", "Batsman": "10201", "Commentary": "No run.", "Summary": {"Score": "38/7", "Over": "10", "Runs": "2", "Wickets": "1", "Batsmen": [{"Batsman": "10201", "Isonstrike": true, "Runs": "0", "Balls": "1", "Fours": "0", "Sixes": "0"}, {"Batsman": "3656", "Runs": "2", "Balls": "3", "Fours": "0", "Sixes": "0"}], "Bowlers": [{"Bowler": "7797", "Overs": "2", "Maidens": "0", "Runs": "7", "Wickets": "2"}]}, "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_T