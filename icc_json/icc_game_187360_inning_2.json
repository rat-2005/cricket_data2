}, {"Over": "3.3", "Id": "25", "UID": null, "OID": null, "Isboundary": true, "Runs": "4", "ZAD": "4,174,5", "Detail": "", "Isball": true, "Bowler": "65867", "Batsman": "4330", "Commentary": "FOUR! Classic Williamson. Shorter on length outside off. Williamson gets on top of the bounce on that one and cuts it away through point for a boundary.", "Timestamp": "2019-01-31T04:41:17+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "3.2", "Id": "24", "UID": null, "OID": null, "Runs": "1", "ZAD": "2,54,3", "Detail": "", "Isball": true, "Bowler": "65867", "Batsman": "57594", "Commentary": "Back of a length, Nicholls tries to play it on the off side but gets an inside edge. The ball goes towards fine leg and the batsmen pick up a single.", "Timestamp": "2019-01-31T04:40:14+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "3.1", "Id": "23", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "65867", "Batsman": "57594", "Commentary": "Length delivery on off, Nicholls defends it.", "Timestamp": "2019-01-31T04:39:42+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "2.6", "Id": "22", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4330", "Commentary": "BEAUTY! Angles this into the off pole first, it pitches and then shapes away. Williamson looks to defend but gets beaten.", "Summary": {"Score": "25/1", "Over": "3", "Runs": "2", "Wickets": "0", "Batsmen": [{"Batsman": "4330", "Isonstrike": true, "Runs": "2", "Balls": "8", "Fours": "0", "Sixes": "0"}, {"Batsman": "57594", "Runs": "8", "Balls": "7", "Fours": "2", "Sixes": "0"}], "Bowlers": [{"Bowler": "5132", "Overs": "2", "Maidens": "0", "Runs": "16", "Wickets": "1"}]}, "Timestamp": "2019-01-31T04:38:47+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "2.5", "Id": "21", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4330", "Commentary": "Excellent line and length! On off and around a length. Blocked.", "Timestamp": "2019-01-31T04:38:15+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "2.4", "Id": "20", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4330", "Commentary": "A touch fuller this time and Kane blocks it.", "Timestamp": "2019-01-31T04:37:48+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "2.3", "Id": "19", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4330", "Commentary": "Back of a length again and Williamson pushes it to covers.", "Timestamp": "2019-01-31T04:37:16+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "2.2", "Id": "18", "UID": null, "OID": null, "Runs": "2", "ZAD": "4,146,3", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4330", "Commentary": "Length delivery on middle, Williamson defends it with soft hands. The ball hits the outer half of the bat and goes towards third man for a couple.", "Timestamp": "2019-01-31T04:36:47+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "2.1", "Id": "17", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4330", "Commentary": "Length delivery outside off, Kane leaves it alone.", "Timestamp": "2019-01-31T04:36:06+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "1.6", "Id": "16", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "65867", "Batsman": "57594", "Commentary": "The batsman has defended it by getting right behind the line of the delivery.", "Summary": {"Score": "23/1", "Over": "2", "Runs": "9", "Wickets": "0", "Batsmen": [{"Batsman": "57594", "Isonstrike": true, "Runs": "8", "Balls": "7", "Fours": "2", "Sixes": "0"}, {"Batsman": "4330", "Runs": "0", "Balls": "2", "Fours": "0", "Sixes": "0"}], "Bowlers": [{"Bowler": "65867", "Overs": "1", "Maidens": "0", "Runs": "9", "Wickets": "0"}]}, "Timestamp": "2019-01-31T04:35:11+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "1.5", "Id": "15", "UID": null, "OID": null, "Isboundary": true, "Runs": "4", "ZAD": "5,209,5", "Detail": "", "Isball": true, "Bowler": "65867", "Batsman": "57594", "Commentary": "FOUR! Takes full toll of the Free Hit. It is full and on off, Nicholls clears his front leg and hits it over the cover fielder and into the fence. Second boundary of the over and the Kiwis are off to a flier.", "Timestamp": "2019-01-31T04:34:41+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "1.5", "Id": "14", "UID": null, "OID": null, "Runs": "1", "ZAD": "", "Detail": "nb", "Isball": true, "Bowler": "65867", "Batsman": "57594", "Commentary": "NO BALL! Free Hit coming up! On off, Nicholls blocks it. Khaleel has overstepped by just.", "Timestamp": "2019-01-31T04:34:05+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "1.4", "Id": "13", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "65867", "Batsman": "57594", "Commentary": "Outside off, left alone.", "Timestamp": "2019-01-31T04:33:17+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "1.3", "Id": "12", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "65867", "Batsman": "57594", "Commentary": "Fuller in length on off, it is stroked to mid off.", "Timestamp": "2019-01-31T04:32:49+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "1.2", "Id": "11", "UID": null, "OID": null, "Isboundary": true, "Runs": "4", "ZAD": "1,11,5", "Detail": "", "Isball": true, "Bowler": "65867", "Batsman": "57594", "Commentary": "FOUR! Nicholls too is off the mark with a boundary! Short and it sits up to be hit. He goes back and pulls it over square leg for a boundary.", "Timestamp": "2019-01-31T04:32:20+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "1.1", "Id": "10", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "65867", "Batsman": "57594", "Commentary": "Good length on off, Nicholls keeps it out.", "Timestamp": "2019-01-31T04:31:55+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "9", "UID": null, "OID": null, "Runs": "", "ZAD": "", "Detail": "", "Isball": false, "Bowler": "", "Batsman": "", "Commentary": "Khaleel Ahmed to bowl from the other end.", "Timestamp": "2019-01-31T04:31:18+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "0.6", "Id": "8", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4330", "Commentary": "Back of a length delivery on off, Williamson looks to defend but gets an inside edge onto the pads. Luckily for him, he doesn't chop it onto his stumps.", "Summary": {"Score": "14/1", "Over": "1", "Runs": "14", "Wickets": "1", "Batsmen": [{"Batsman": "4330", "Isonstrike": true, "Runs": "0", "Balls": "2", "Fours": "0", "Sixes": "0"}, {"Batsman": "57594", "Runs": "0", "Balls": "0", "Fours": "0", "Sixes": "0"}], "Bowlers": [{"Bowler": "5132", "Overs": "1", "Maidens": "0", "Runs": "14", "Wickets": "1"}]}, "Timestamp": "2019-01-31T04:30:38+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "0.5", "Id": "7", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4330", "Commentary": "Good length delivery on middle and off, Williamson starts with a front foot defense.", "Timestamp": "2019-01-31T04:30:11+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "6", "UID": null, "OID": null, "Runs": "", "ZAD": "", "Detail": "", "Isball": false, "Bowler": "", "Batsman": "", "Commentary": "Kane Williamson is the new man in.", "Timestamp": "2019-01-31T04:29:05+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "0.4", "Id": "5", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "W", "Isball": true, "Bowler": "5132", "Batsman": "4964", "Commentary": "OUT! Guptill is in too much of a hurry to finish off this game and ends up playing a shot too many. He now has to walk back. Length delivery on middle and leg, Guptill tries to flick it on the on side but is early in his shot. It finds the leading edge and goes straight to point. Hardik Pandya there takes an easy catch and gives them the breakthrough. But with just 93 required one can say he has provided them the platform, if they ever needed one in this chase.", "Iswicket": true, "Dismissed": "4964", "Timestamp": "2019-01-31T04:28:53+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "0.3", "Id": "4", "UID": null, "OID": null, "Isboundary": true, "Runs": "4", "ZAD": "1,10,5", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4964", "Commentary": "FOUR! On middle and leg, a bit shorter in length this time, Guptill flicks it away through square leg for another boundary. He wants to finish this off early.", "Timestamp": "2019-01-31T04:27:55+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "0.2", "Id": "3", "UID": null, "OID": null, "Isboundary": true, "Runs": "4", "ZAD": "7,298,5", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4964", "Commentary": "FOUR! Overpitched on middle and leg, Guptil hits it straight through mid on for a boundary.", "Timestamp": "2019-01-31T04:27:27+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "0.1", "Id": "2", "UID": null, "OID": null, "Isboundary": true, "Runs": "6", "ZAD": "8,330,6", "Detail": "", "Isball": true, "Bowler": "5132", "Batsman": "4964", "Commentary": "SIX! Brilliant start. Full on middle and leg, Guptill lofts it over mid-wicket for a maximum. What a start for New Zealand.", "Timestamp": "2019-01-31T04:27:05+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "1", "UID": null, "OID": null, "Runs": "", "ZAD": "", "Detail": "", "Isball": false, "Bowler": "", "Batsman": "", "Commentary": "We are back for the chase. Martin Guptill and Henry Nicholls open the innings. Bhuvneshwar Kumar to bowl the first over.", "Timestamp": "2019-01-31T04:26:25+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}], "Deleted_UID": null}, "meta": {"app_status_code": 1, "message": "Success", "pagination": true, "count": 103, "timestamp": {"utc_time": "6/20/2026 7:15:23 AM"}}}