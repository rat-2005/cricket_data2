ry": "No run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "15.1", "Id": "98", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "10179", "Batsman": "57952", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "97", "UID": null, "OID": null, "Runs": "", "ZAD": null, "Detail": "", "Isball": false, "Bowler": "", "Batsman": "", "Commentary": "After 15 overs, BANGLADESH HAVE BEEN RESTRICTED TO 123/4! The Kiwis gave away just 34 runs in the period of 10-15 overs. 15 of those runs were given by Boult who is having a day to forget. The spinners kept it tight once again with Santner, Williamson and Sodhi giving away just 19 runs off their 4 overs and picking up 2 wickets as well. Sabbir was the first one to depart when he dragged on one of the Williamson's deliveries. Mahmudullah, who replaced him tried to get the run rate up but got bowled by Sodhi in that process. Bangladesh are falling behind now as they NEED 72 RUNS MORE TO WIN OFF THE LAST 5 OVERS! Remember, even NZ scored 69 runs in their last 5!", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.6", "Id": "96", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "57625", "Batsman": "57952", "Commentary": "1 run.", "Summary": {"Score": "123/4", "Over": "15", "Runs": "3", "Wickets": "1", "Batsmen": [{"Batsman": "57952", "Isonstrike": true, "Runs": "1", "Balls": "1", "Fours": "0", "Sixes": "0"}, {"Batsman": "3782", "Runs": "16", "Balls": "16", "Fours": "0", "Sixes": "0"}], "Bowlers": [{"Bowler": "57625", "Overs": "3", "Maidens": "0", "Runs": "13", "Wickets": "2"}]}, "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.5", "Id": "95", "U