/0", "Batsman_Runs": "6", "Bowler_Conceded_Runs": "6", "Ball_Speed": "110.0kph", "Ball_Number": "28", "Milestone": [], "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.3", "Id": "29", "UID": null, "OID": null, "Isboundary": true, "Runs": "6", "ZAD": "5,210,5", "Detail": "", "Isball": true, "Bowler": "58314", "Bowler_Name": "Taskin Ahmed", "Batsman": "4196", "Batsman_Name": "Aaron Finch", "Batsman_Style": "R", "Commentary": "SIX! Much better from Finch, he stands tall and delivers. A length ball, around off. Finch gets under it and powers it over the cover fence for a maximum.", "Timestamp": "2021-11-04T12:01:07+00:00", "Non_Striker": "5380", "Non_Striker_Name": "David Warner", "Score": "52/0", "Batsman_Runs": "6", "Bowler_Conceded_Runs": "6", "Ball_Speed": "134.0kph", "Ball_Number": "27", "Milestone": [{"Event_Type_Id": 1, "Team_Id": 1, "Event_Id": 1, "Event": "50 Runs"}, {"Event_Type_Id": 2, "Event_Id": 1, "Event": "30 Runs"}], "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.2", "Id": "28", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "58314", "Bowler_Name": "Taskin Ahmed", "Batsman": "4196", "Batsman_Name": "Aaron Finch", "Batsman_Style": "R", "Commentary": "Finch tries to be innovative now but does not get the connection at all. Full length and just outside off. Finch changes his stance and looks to scoop it above the keeper's head, but misses. He gets hit on the pads, Ahmed appeals but the umpire says no.", "Timestamp": "2021-11-04T11:59:52+00:00", "Non_Striker": "5380", "Non_Striker_Name": "David Warner", "Score": "46/0", "Batsman_Runs": "0", "Bowler_Conceded_Runs": "0", "Ball_Speed": "145.0kph", "Ball_Number": "26", "Milestone": [], "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.1", "Id": "27", "UID": null, "OID": null, "Runs": "2", "ZAD": "7,283,4", "Detail": ""