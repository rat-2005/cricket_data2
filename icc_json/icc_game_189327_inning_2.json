_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.5", "Id": "36", "UID": null, "OID": null, "Runs": "1", "ZAD": "5,196,4", "Detail": "", "Isball": true, "Bowler": "10201", "Bowler_Name": "Tendai Chatara", "Batsman": "4476", "Batsman_Name": "Paul Stirling", "Commentary": "Full and outside off, driven through the covers for a single.", "Timestamp": "2019-07-12T18:14:12+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.4", "Id": "35", "UID": null, "OID": null, "Isboundary": true, "Runs": "4", "ZAD": "5,191,5", "Detail": "", "Isball": true, "Bowler": "10201", "Bowler_Name": "Tendai Chatara", "Batsman": "4476", "Batsman_Name": "Paul Stirling", "Commentary": "FOUR! Another cracking shot. A low full toss outside off, Stirling comes down the track and bashes it through the covers!", "Timestamp": "2019-07-12T18:13:37+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.3", "Id": "34", "UID": null, "OID": null, "Runs": "1", "ZAD": "8,343,2", "Detail": "", "Isball": true, "Bowler": "10201", "Bowler_Name": "Tendai Chatara", "Batsman": "3773", "Batsman_Name": "Kevin O'Brien", "Commentary": "Short ball, outside leg stump, Kevin O'Brien makes room to the leg stump but gets cramped as Chatara follows him. O'Brien pushes it to the leg side for a single.", "Timestamp": "2019-07-12T18:13:04+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.2", "Id": "33", "UID": null, "OID": null, "Runs": "1", "ZAD": "4,163,3", "Detail": "", "Isball": true, "Bowler": "10201", "Bowler_Name": "Tendai Chatara", "Batsman": "4476", "Batsman_Name": "Paul Stirling", "Commentary": "Outside off, played through point for a single.", "Timestamp": "2019-07-12T18:12:20+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Ty