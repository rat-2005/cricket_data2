amp": "2020-01-20T00:48:31+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.2", "Id": "29", "UID": null, "OID": null, "Runs": "1", "ZAD": "5,211,2", "Detail": "", "Isball": true, "Bowler": "65690", "Bowler_Name": "Mark Adair", "Batsman": "3861", "Batsman_Name": "Lendl Simmons", "Commentary": "Shorter, this is slapped wide of mid off for one.", "Timestamp": "2020-01-20T00:47:53+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.1", "Id": "28", "UID": null, "OID": null, "Runs": "1", "ZAD": "5,206,3", "Detail": "", "Isball": true, "Bowler": "65690", "Bowler_Name": "Mark Adair", "Batsman": "59314", "Batsman_Name": "Evin Lewis", "Commentary": "In the air... safe! A full ball outside off, Lewis looks to go big but ends up slicing it over covers for one.", "Timestamp": "2020-01-20T00:47:26+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "3.6", "Id": "27", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "66081", "Bowler_Name": "Joshua Little", "Batsman": "3861", "Batsman_Name": "Lendl Simmons", "Commentary": "That ball has struck the batsman on the thigh pad. A good comeback from the bowler after going for a boundary on the first ball.", "Summary": {"Score": "33/0", "Over": "4", "Runs": "6", "Wickets": "0", "Batsmen": [{"Batsman": "3861", "Isonstrike": true, "Runs": "22", "Balls": "16", "Fours": "3", "Sixes": "1"}, {"Batsman": "59314", "Runs": "11", "Balls": "8", "Fours": "0", "Sixes": "1"}], "Bowlers": [{"Bowler": "66081", "Overs": "1", "Maidens": "0", "Runs": "6", "Wickets": "0"}]}, "Timestamp": "2020-01-20T00:45:32+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "3.5", "Id": "26", "UID": null, "OID": null, "Runs": "1", "ZAD": "8,