 television feed, there will be no commentary for this game. But we will keep you posted with regular updates.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.6", "Id": "97", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "63881", "Batsman": "65344", "Commentary": "1 run.", "Summary": {"Score": "153/3", "Over": "15", "Runs": "8", "Wickets": "0", "Batsmen": [{"Batsman": "65344", "Isonstrike": true, "Runs": "37", "Balls": "25", "Fours": "2", "Sixes": "1"}, {"Batsman": "11724", "Runs": "96", "Balls": "49", "Fours": "7", "Sixes": "7"}], "Bowlers": [{"Bowler": "63881", "Overs": "3", "Maidens": "0", "Runs": "22", "Wickets": "0"}]}, "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.5", "Id": "96", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "63881", "Batsman": "11724", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.4", "Id": "95", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "63881", "Batsman": "65344", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.3", "Id": "94", "UID": null, "OID": null, "Runs": "0", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "63881", "Batsman": "65344", "Commentary": "No run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.2", "Id": "93", "UID": null, "OID": null, "Isboundary": true, "Runs": "4", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "63881", "Batsman": "65344", "Commentary": "FOUR.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": "