l, on middle. Max O'Dowd\u00a0defends it out.", "Timestamp": "2021-11-26T12:11:52+00:00", "Non_Striker": "22116", "Non_Striker_Name": "Stephan Myburgh", "Score": "0/0", "Batsman_Runs": "0", "Bowler_Conceded_Runs": "0", "Ball_Speed": "", "Ball_Number": "1", "Milestone": [], "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}], "InningNo": "2", "BattingTeam_Id": "15", "BattingTeam": "Netherlands", "BowlingTeam_Id": "7", "BowlingTeam": "South Africa", "GameCode": "sane11262021205338", "MatchId": "205338", "Timestamp": "11/26/2021T20:24:56+05:30", "Deleted_UID": null}, "meta": {"app_status_code": 1, "message": "Success", "pagination": true, "count": 21, "timestamp": {"utc_time": "6/20/2026 7:18:56 AM"}}}