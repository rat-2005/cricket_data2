n.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "15.3", "Id": "100", "UID": null, "OID": null, "Runs": "0", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "3782", "Batsman": "4330", "Commentary": "No run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "15.2", "Id": "99", "UID": null, "OID": null, "Runs": "2", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "3782", "Batsman": "4330", "Commentary": "2 runs.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "15.1", "Id": "98", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "3782", "Batsman": "4332", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "97", "UID": null, "OID": null, "Runs": "", "ZAD": null, "Detail": "", "Isball": false, "Bowler": "", "Batsman": "", "Commentary": "After 15 overs, NEW ZEALAND HAVE CRUISED THROUGH TO 125/3! The Black Caps scored 70 runs in the last 5 overs. The skipper took the matter in his own hands scoring 32 runs in his last 18 balls. Anderson too came into the party and scored 34 runs in his last 12. Both these batsmen are looking good and setting themselves for a huge total. Williamson completed his 7th T20I but soon after was given a life by Shakib, who dropped a sitter. The bowlers who had kept it tight early on just couldn't hold back these two. Imrul Kayes collided with one of the advertising boards on the boundary and has left the field.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.6", "Id": "96", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "1948", "Batsman": "4332", "Commentary": "1 run.", "Summ