 ""}, {"Over": "0.1", "Id": "2", "UID": null, "OID": null, "Runs": "0", "ZAD": "", "Detail": "", "Isball": true, "Bowler": "61505", "Batsman": "22878", "Commentary": "Good start. Neither too full, nor too short, plenty of swing. Flicked towards short mid-wicket.", "Timestamp": "2019-03-10T21:21:39+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "1", "UID": null, "OID": null, "Runs": "", "ZAD": "", "Detail": "", "Isball": false, "Bowler": "", "Batsman": "", "Commentary": "Welcome back for the run chase. Sheldon Cottrell to begin the final run chase of this tour. Alex Hales and Jonny Bairstow are the openers. The former to face.", "Timestamp": "2019-03-10T21:19:43+00:00", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}], "Deleted_UID": null}, "meta": {"app_status_code": 1, "message": "Success", "pagination": true, "count": 81, "timestamp": {"utc_time": "6/20/2026 7:15:32 AM"}}}