ID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "61831", "Batsman": "4330", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "95", "UID": null, "OID": null, "Runs": "", "ZAD": null, "Detail": "", "Isball": false, "Bowler": "", "Batsman": "", "Commentary": "UPDATE 11-15 overs, NZ 108/4 - The Black Caps are marching towards a comprehensive victory in Napier. It has been a terrific knock from Kane! He has held his composure to score a crucial fifty. The visitors have been unable to tie him and Grandhomme down. With 34 runs to chase in the last five overs, it should be a walk in the park for the home side. But do not count the visitors out as miracles do happen. Due to the lack of television feed there won't be any commentary for this game but we will provide you with updates every 5 overs.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.6", "Id": "94", "UID": null, "OID": null, "Runs": "0", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "4371", "Batsman": "11703", "Commentary": "No run.", "Summary": {"Score": "108/4", "Over": "15", "Runs": "15", "Wickets": "0", "Batsmen": [{"Batsman": "11703", "Isonstrike": true, "Runs": "19", "Balls": "13", "Fours": "0", "Sixes": "2"}, {"Batsman": "4330", "Runs": "60", "Balls": "46", "Fours": "5", "Sixes": "1"}], "Bowlers": [{"Bowler": "4371", "Overs": "3", "Maidens": "0", "Runs": "30", "Wickets": "1"}]}, "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.5", "Id": "93", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "4371", "Batsman": "4330", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.4", "Id": "92", "UI