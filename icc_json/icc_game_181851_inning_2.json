ne": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "5.1", "Id": "38", "UID": null, "OID": null, "Isboundary": true, "Runs": "4", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "9797", "Batsman": "59429", "Commentary": "FOUR! DRILLED! Over pitched delivery outside off, Azam goes for a cover drive and the ball goes through the gap for a boundary.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.6", "Id": "37", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "3556", "Batsman": "59429", "Commentary": "Fuller ball on middle and leg, Babar flicks it down the leg side for a single.", "Summary": {"Score": "33/1", "Over": "5", "Runs": "5", "Wickets": "0", "Batsmen": [{"Batsman": "59429", "Isonstrike": true, "Runs": "2", "Balls": "3", "Fours": "0", "Sixes": "0"}, {"Batsman": "3985", "Runs": "6", "Balls": "9", "Fours": "1", "Sixes": "0"}], "Bowlers": [{"Bowler": "3556", "Overs": "1", "Maidens": "0", "Runs": "5", "Wickets": "0"}]}, "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.5", "Id": "36", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "3556", "Batsman": "3985", "Commentary": "Length ball on middle, flicked to square leg for a single.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.4", "Id": "35", "UID": null, "OID": null, "Runs": "0", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "3556", "Batsman": "3985", "Commentary": "Full and around middle, Latif looks to defend but gets a thick inside edge onto his pads.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.3", "Id": "34", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "3556", "Batsman": "59429", "Commentary": "Driven through mid on by the batsman. They pick up a single.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.2", "Id": "33", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "3556", "Batsman": "3985", "Commentary": "IN THE AIR... SAFE! Fuller on middle, good change in pace, Latif is early into his flick and checks his shot. Spoons it over the bowler towards long on and gets a single. Bravo has his hands over his head.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.1", "Id": "32", "UID": null, "OID": null, "Runs": "0", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "3556", "Batsman": "3985", "Commentary": "This is wide outside off, Khalid throws his bat at it and gets a bottom edge. The ball runs fine but the keeper dives to his right to stop it with one glove.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "4.1", "Id": "31", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "wd", "Isball": true, "Bowler": "3556", "Batsman": "3985", "Commentary": "WIDE. A slower ball goes awry, bowls it way down the leg side, Latif misses his flick.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "30", "UID": null, "OID": null, "Runs": "", "ZAD": null, "Detail": "", "Isball": false, "Bowler": "", "Batsman": "", "Commentary": "Dwayne Bravo comes into the attack.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "3.6", "Id": "29", "UID": null, "OID": null, "Runs": "0", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "9797", "Batsman": "59429", "Commentary": "Full on middle, driven through 