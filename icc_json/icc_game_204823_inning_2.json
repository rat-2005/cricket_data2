": true, "Bowler": "64951", "Bowler_Name": "Brandon Glover", "Batsman": "65030", "Batsman_Name": "Avishka Fernando", "Batsman_Style": "R", "Commentary": "A full ball, on middle, flicked to mid-wicket.", "Timestamp": "2021-10-22T15:53:42+00:00", "Non_Striker": "11757", "Non_Striker_Name": "Kusal Perera", "Score": "40/2", "Batsman_Runs": "0", "Bowler_Conceded_Runs": "0", "Ball_Speed": "136.0kph", "Ball_Number": "37", "Milestone": [], "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "49", "UID": null, "OID": null, "Runs": "", "ZAD": "", "Detail": "", "Isball": false, "Bowler": "", "Bowler_Name": "", "Batsman": "", "Batsman_Name": "", "Batsman_Style": "", "Commentary": "Brandon Glover\u00a0pulls out before delivering the ball. Not quite sure what was the issue.", "Timestamp": "2021-10-22T15:54:25+00:00", "Non_Striker": "", "Non_Striker_Name": "", "Score": "", "Batsman_Runs": "", "Bowler_Conceded_Runs": "", "Ball_Speed": "", "Ball_Number": "", "Milestone": [], "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "6.1", "Id": "48", "UID": null, "OID": null, "Runs": "1", "ZAD": "", "Detail": "wd", "Isball": true, "Bowler": "64951", "Bowler_Name": "Brandon Glover", "Batsman": "65030", "Batsman_Name": "Avishka Fernando", "Batsman_Style": "R", "Commentary": "WIDE! Serves a length ball, way outside off. Fernando leaves it alone. Wided.", "Timestamp": "2021-10-22T15:53:06+00:00", "Non_Striker": "11757", "Non_Striker_Name": "Kusal Perera", "Score": "40/2", "Batsman_Runs": "0", "Bowler_Conceded_Runs": "1", "Extras_Runs": "1", "Ball_Speed": "", "Ball_Number": "37", "Milestone": [], "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "5.6", "Id": "47", "UID": null, "OID": null, "Isboundary": true, "Runs": "4", "ZAD": "5,220,5", "Detail": "", "Isball": true, "Bowler": "63893", "Bowler_Name": "Paul van Meekeren", "Batsman": "11757", "Batsm