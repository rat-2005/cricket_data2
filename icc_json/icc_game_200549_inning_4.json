s": "", "ZAD": "", "Detail": "", "Isball": false, "Bowler": "", "Bowler_Name": "", "Batsman": "", "Batsman_Name": "", "Batsman_Style": "", "Commentary": "Yamin Ahmadzai to bowl from the other end.", "Timestamp": "2021-03-03T12:30:30+00:00", "Non_Striker": "", "Non_Striker_Name": "", "Score": "", "Batsman_Runs": "", "Bowler_Conceded_Runs": "", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "0.6", "Id": "6", "UID": null, "OID": null, "Runs": "0", "ZAD": "5,224,1", "Detail": "", "Isball": true, "Bowler": "10104", "Bowler_Name": "Amir Hamza", "Batsman": "60177", "Batsman_Name": "Kevin Kasuza", "Batsman_Style": "R", "Commentary": "On off, Kasuza defends it off the front foot.", "Summary": {"Score": "5/0", "Over": "1", "Runs": "5", "Wickets": "0", "Batsmen": [{"Batsman": "60177", "Isonstrike": true, "Runs": "4", "Balls": "4", "Fours": "1", "Sixes": "0"}, {"Batsman": "4281", "Runs": "1", "Balls": "2", "Fours": "0", "Sixes": "0"}], "Bowlers": [{"Bowler": "10104", "Overs": "1", "Maidens": "0", "Runs": "5", "Wickets": "0"}]}, "Timestamp": "2021-03-03T12:29:03+00:00", "Non_Striker": "4281", "Non_Striker_Name": "Prince Masvaure", "Score": "5/0", "Batsman_Runs": "0", "Bowler_Conceded_Runs": "0", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "0.5", "Id": "5", "UID": null, "OID": null, "Runs": "0", "ZAD": "7,302,1", "Detail": "", "Isball": true, "Bowler": "10104", "Bowler_Name": "Amir Hamza", "Batsman": "60177", "Batsman_Name": "Kevin Kasuza", "Batsman_Style": "R", "Commentary": "Loopy delivery on off, Kasuza blocks it off the front foot.", "Timestamp": "2021-03-03T12:28:45+00:00", "Non_Striker": "4281", "Non_Striker_Name": "Prince Masvaure", "Score": "5/0", "Batsman_Runs": "0", "Bowler_Conceded_Runs": "0", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "0.4", "Id": "4", "UID"