ler": "", "Overs": "0.5", "Maidens": "0", "Runs": "5", "Wickets": "0"}, "Milestone": [], "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "22", "UID": null, "OID": null, "Runs": "", "ZAD": "", "Detail": "", "Isball": false, "Bowler": "", "Bowler_Name": "", "Batsman": "", "Batsman_Name": "", "Batsman_Style": "", "Commentary": "Review! Zimbabwe\u00a0have taken a review for an LBW decision against\u00a0Quinton de Kock.", "Timestamp": "2022-10-24T12:06:59+00:00", "Non_Striker": "", "Non_Striker_Name": "", "Score": "", "Batsman_Runs": "", "Bowler_Conceded_Runs": "", "Ball_Speed": "", "Ball_Number": "", "Over_No": "", "Ball": "", "Ball_Line_Length": "", "This_Over": "", "Milestone": [], "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "2.4", "Id": "21", "UID": null, "OID": null, "Runs": "1", "ZAD": "4,165,2", "Detail": "", "Isball": true, "Bowler": "25422", "Bowler_Name": "Sikandar Raza", "Batsman": "12492", "Batsman_Name": "Temba Bavuma", "Batsman_Style": "R", "Commentary": "Very full and around off, Bavuma tries to play the reverse-batted shot but scuffs it off the bottom edge. It rolls towards the off side and they cross.", "Timestamp": "2022-10-24T12:01:39+00:00", "Non_Striker": "28035", "Non_Striker_Name": "Quinton de Kock", "Score": "45/0", "Batsman_Runs": "1", "Bowler_Conceded_Runs": "1", "Ball_Speed": "89.0kph", "Ball_Number": "16", "Over_No": "3", "Ball": "4", "Ball_Line_Length": "29,4,9,8,26,25", "This_Over": "1,2,1,1,", "Batsman_Details": {"Batsman": "", "Runs": "2", "Balls": "2", "Fours": "0", "Sixes": "0"}, "Non_Striker_Details": {"Batsman": "", "Runs": "42", "Balls": "15", "Fours": "8", "Sixes": "1"}, "Bowler_Details": {"Bowler": "", "Overs": "0.4", "Maidens": "0", "Runs": "5", "Wickets": "0"}, "Milestone": [], "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "2.3", "Id": "20", "UID": null, "OID": null, "Ru