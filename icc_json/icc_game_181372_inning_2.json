 "ZAD": null, "Detail": "", "Isball": true, "Bowler": "57903", "Batsman": "10219", "Commentary": "2 runs.", "Summary": {"Score": "142/6", "Over": "16", "Runs": "6", "Wickets": "0", "Batsmen": [{"Batsman": "10219", "Isonstrike": true, "Runs": "8", "Balls": "6", "Fours": "0", "Sixes": "0"}, {"Batsman": "3956", "Runs": "17", "Balls": "13", "Fours": "0", "Sixes": "1"}], "Bowlers": [{"Bowler": "57903", "Overs": "3", "Maidens": "0", "Runs": "14", "Wickets": "1"}]}, "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "15.5", "Id": "107", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "57903", "Batsman": "3956", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "15.4", "Id": "106", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "57903", "Batsman": "10219", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "15.3", "Id": "105", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "57903", "Batsman": "3956", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "15.2", "Id": "104", "UID": null, "OID": null, "Runs": "0", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "57903", "Batsman": "3956", "Commentary": "No run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "15.1", "Id": "103", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "57903", "Batsman": "10219", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "", "Id": "102", "UID": null, "OID": null, "Runs": "", "ZAD": null, "Detail": "", "Isball": false, "Bowler": "", "Batsman": "", "Commentary": "After 15 overs, BANGLADESH HAVE REACHED 136/6. The game has suddenly changed in the last 4 overs. The visitors were going really well in the 11th over, thanks to the Sarkar-Sabbir stand. At that stage, 92 was needed from 56 balls when the former fell. That led to a couple of more wickets and New Zealand are now in firm control. Santner, Sodhi and Williamson have done a wonderful job, keeping a hold on the proceedings. Mahmudullah is still out there in the middle but with 60 needed from 5 overs and not much batting left, this seems to be out of bounds for the touring side. Unfortunately, due to lack of television feed, there will be no commentary for this game. But we will keep you posted with regular updates.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.6", "Id": "101", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "57625", "Batsman": "10219", "Commentary": "1 run.", "Summary": {"Score": "136/6", "Over": "15", "Runs": "13", "Wickets": "0", "Batsmen": [{"Batsman": "10219", "Isonstrike": true, "Runs": "4", "Balls": "3", "Fours": "0", "Sixes": "0"}, {"Batsman": "3956", "Runs": "15", "Balls": "10", "Fours": "0", "Sixes": "1"}], "Bowlers": [{"Bowler": "57625", "Overs": "3", "Maidens": "0", "Runs": "31", "Wickets": "1"}]}, "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.5", "Id": "100", "UID": null, "OID": null, "Runs": "1", "ZAD": null, "Detail": "", "Isball": true, "Bowler": "57625", "Batsman": "3956", "Commentary": "1 run.", "Milestone": null, "Edited_Commentary": 0, "Default_Commentary": "", "Shot_Type_Id": "", "Shot_Type": ""}, {"Over": "14.4", "Id": "99", "UID": null, "OID": null, "Isboundary": true, "Runs": "6", "ZAD": null, "Detail": "", "Isbal